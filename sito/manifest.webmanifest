{
 "name": "file360 — strumenti PDF nel tuo browser",
 "short_name": "file360",
 "lang": "it",
 "start_url": "/",
 "scope": "/",
 "display": "standalone",
 "id": "/",
 "background_color": "#ffffff",
 "theme_color": "#5B2EFF",
 "description": "Strumenti PDF che lavorano nel tuo browser: nessun file viene caricato su un server.",
 "icons": [
  {
   "src": "/icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "/icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "/icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "/",
   "accept": {
    "application/pdf": [
     ".pdf"
    ],
    "image/jpeg": [
     ".jpg",
     ".jpeg"
    ],
    "image/png": [
     ".png"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 }
}